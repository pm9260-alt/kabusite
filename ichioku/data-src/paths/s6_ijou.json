      "next": { "in": [6, 10], "node": "heion" } }
  ],
  "nodes": {
    "junbi": {
      "say": "探検船は木造の小さな帆船で、寄付金は予定の半分にも届かなかった。",
      "fx": { "sat": -1, "learn": 2, "tie": -1, "body": 0 },
      "ask": { "title": "何年も家を空ける", "text": "出航すれば、帰りは早くて二年先になる。妻は赤子を抱えて、行かないでくれと泣いた。どうする？",
        "opts": [
          { "k": "go", "l": "船に乗る", "f": ["study"], "w": 1,
            "say": "{name}は妻に家と赤子を託し、見送りの旗に背を向けて船に乗った。",
            "fx": { "sat": 4, "learn": 5, "tie": -6, "body": -3 }, "away": true,
            "next": { "in": [2, 3], "node": "hinomaru" } },
          { "k": "stay", "l": "家族のもとに残る", "f": ["family"], "w": 1,
            "say": "{name}は隊を離れ、港で船を見送った。",
