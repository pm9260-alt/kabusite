      "fx": { "sat": 3, "learn": 5, "tie": -1, "body": -1 },
      "next": { "in": [3, 6], "node": "nanmon" } },
    { "k": "stay", "l": "家の仕事に戻る", "f": ["family"], "w": 1,
      "say": "{name}は図を足で消して家に戻り、{dad}の手伝いをした。",
      "fx": { "sat": -1, "learn": 0, "tie": 3, "body": 1 },
      "next": { "in": [6, 10], "node": "soroban" } }
  ],
  "nodes": {
    "nanmon": {
      "say": "{name}は寝る間を惜しんで算木を並べ、師の出した問題をすべて解いてしまった。",
      "fx": { "sat": 2, "learn": 4, "tie": -2, "body": -1 },
      "ask": { "title": "帳簿か算額か", "text": "家業の帳簿の付け落としが続き、{dad}が「算術は家のためにやれ」と算盤を取り上げようとした。新しい解き方はあと一歩まで来ていた。どうする？",
        "opts": [
          { "k": "go", "l": "解き方を詰める", "f": ["study"], "w": 1,
            "say": "{name}は家を出て師の家に住みこみ、解き方を書き上げた。{dad}とは口をきかなくなった。",
            "fx": { "sat": 4, "learn": 5, "tie": -5, "body": -2 }, "away": true,
            "next": { "in": [5, 10], "node": "sho" } },
          { "k": "stay", "l": "帳簿を立て直す", "f": ["family"], "w": 1,
            "say": "{name}は算術を夜だけの楽しみにして、家の帳簿をきちんと付け直した。",
            "fx": { "sat": -2, "learn": 1, "tie": 4, "body": 1 },
            "next": { "in": [5, 8], "node": "soroban" } }
        ] }
    },
    "sho": {
      "say": "{name}の新しい解き方は版木に彫られて書物となり、諸国から弟子が訪ねてきた。のちに従四位を贈られた。",
      "fx": { "sat": 6, "learn": 4, "tie": -1, "body": -2 }, "feat": true,
      "honor": { "t": "従四位", "k": "zoui" },
      "job": { "n": "算学の師匠", "pay": 600, "cat": "teacher" }
    },
    "soroban": { "say": "{name}は村の子らに算盤を教え、年貢の割り付けでもめると村役人に呼ばれて勘定を確かめた。",
      "fx": { "sat": 3, "learn": 1, "tie": 4, "body": 0 } }
  }
},
{
