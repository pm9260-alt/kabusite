            "next": { "in": [4, 8], "node": "heion" } }
        ] }
    },
    "hinomaru": {
      "say": "{name}の隊は犬ぞりで氷原を進み、南の大陸に日の丸を立てた。帰国すると港は歓迎の人で埋まり、勲五等瑞宝章を受けた。",
      "fx": { "sat": 6, "learn": 4, "tie": -1, "body": -4 }, "feat": true, "move": "home",
      "honor": { "t": "勲五等瑞宝章", "k": "kunsho" },
      "next": { "in": [1, 3], "node": "shakkin" }
    },
    "shakkin": { "say": "歓迎の宴が終わると、探検の借金が{name}の肩に残った。{name}は幻灯を携えて各地の学校を回り、講演の謝礼で返し続けた。",
      "fx": { "sat": -2, "learn": 1, "tie": 1, "body": -2 }, "debt": 500 },
    "heion": { "say": "{name}は{place}で子を育てながら、南へ向かった探検船の話を新聞で追いかけ、孫に語って聞かせた。",
      "fx": { "sat": 3, "learn": 1, "tie": 4, "body": 0 } }
  }
},
{
