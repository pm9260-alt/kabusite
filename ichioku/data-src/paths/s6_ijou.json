[
{
  "id": "ij_chizu", "title": "隠居の星学び", "group": "ijou",
  "y": [1760, 1820], "a": [48, 55], "st": ["chonin", "hyakusho"], "sex": "m", "p": 0.004,
  "src": ["ij_watanabe1999", "ij_kokushi", "ij_naikaku_eiten"],
  "text": "家の商いを子に譲った{name}は、江戸に暦と星の測り方を教える学者がいると聞いた。五十を過ぎての学び直しになる。どうする？",
  "opts": [
    { "k": "go", "l": "江戸で星を学ぶ", "f": ["study"], "w": 1,
      "say": "{name}は江戸に出て、自分の子ほどの年の師に弟子入りし、夜ごと星の高さを測った。",
      "fx": { "sat": 3, "learn": 5, "tie": -2, "body": -1 }, "move": "edo", "away": true,
      "next": { "in": [3, 5], "node": "sokuryo" } },
    { "k": "stay", "l": "隠居を楽しむ", "f": ["family"], "w": 1,
      "say": "{name}は江戸行きを思いとどまり、庭に小さな日時計を据えて孫と遊んだ。",
      "fx": { "sat": 1, "learn": -1, "tie": 4, "body": 1 },
      "next": { "in": [4, 8], "node": "inkyo" } }
  ],
  "nodes": {
    "sokuryo": {
      "say": "{name}は一歩の幅をそろえる稽古を重ね、歩いた数で道のりを測れるようになった。",
      "fx": { "sat": 2, "learn": 4, "tie": -1, "body": -1 },
      "ask": { "title": "測量の旅", "text": "公儀の許しを得て、蝦夷地まで歩いて沿岸を測る旅に出る話がまとまった。家の商いは子に任せきりで、帳場からは手代が辞めたという便りが届いていた。どうする？",
        "opts": [
          { "k": "go", "l": "測量の旅に出る", "f": ["study"], "w": 1,
            "say": "{name}は量程車と象限儀を担がせ、蝦夷地へ向けて歩き出した。店のことは子に詫びの文を送っただけだった。",
            "fx": { "sat": 4, "learn": 5, "tie": -5, "body": -3 },
            "next": { "in": [12, 16], "node": "kansei" } },
          { "k": "stay", "l": "店へ戻る", "f": ["family"], "w": 1,
            "say": "{name}は旅を若い弟子に譲り、{place}の店へ戻って帳場に座った。",
            "fx": { "sat": -2, "learn": 0, "tie": 4, "body": 1 }, "move": "home",
            "next": { "in": [3, 6], "node": "mise" } }
        ] }
    },
    "kansei": {
      "say": "{name}が十余年かけて歩いた沿岸の図はつながり、国じゅうを一枚に収めた地図が仕上がった。のちに従四位を贈られた。",
      "fx": { "sat": 6, "learn": 4, "tie": -2, "body": -3 }, "feat": true,
      "honor": { "t": "従四位", "k": "zoui" }
    },
    "mise": { "say": "{name}は店の帳場で、測量で覚えた割り算を手代に教えた。店は持ち直し、孫が跡を継いだ。",
      "fx": { "sat": 3, "learn": 1, "tie": 4, "body": 0 } },
    "inkyo": { "say": "{name}の日時計は近所の評判になり、縁側には毎夕、子らと茶飲み仲間が集まった。",
      "fx": { "sat": 4, "learn": 1, "tie": 4, "body": 0 } }
  }
},
{
  "id": "ij_wasan", "title": "算額の難問", "group": "ijou",
  "y": [1700, 1850], "a": [14, 24], "st": ["hyakusho", "chonin"], "p": 0.004,
  "src": ["ij_ogawa2003", "ij_kokushi"],
  "text": "村の鎮守に奉納された算額に、まだ誰も解けぬ円と三角の問題が書かれていた。{name}は拝殿の前に座りこみ、日が暮れるまで地面に図を描いた。どうする？",
  "opts": [
    { "k": "go", "l": "算学の師につく", "f": ["study"], "w": 1,
