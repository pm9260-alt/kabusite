 {"id":"s6.fb.karada.1","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["このごろ、朝起きると膝が痛む。無理をして今までどおり働くか、仕事を少し減らすか。"],"options":[{"k":"herasu","l":"仕事を少し減らす","fx":{"body":2,"sat":-1},"after":"仕事を少し減らし、膝をいたわりながら働いた。"},{"k":"tsuzukeru","l":"今までどおり働く","fx":{"sat":1,"body":-2},"after":"膝の痛みをこらえて、今までどおりに働いた。"}]},
 {"id":"s6.fb.karada.2","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["大きな荷を持つと、腰に痛みが走るようになった。人に頼むか、自分で続けるか。"],"options":[{"k":"tanomu","l":"荷運びを人に頼む","fx":{"body":2,"sat":-1},"after":"大きな荷は人に頼み、腰をいたわった。"},{"k":"jibun","l":"自分で運び続ける","fx":{"sat":1,"body":-2},"after":"腰の痛みをこらえて、自分で荷を運び続けた。"}]},
 {"id":"s6.fb.karada.3","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["夕方になると目がかすむ。細かい仕事を人に任せるか、目をこらして続けるか。"],"options":[{"k":"makaseru","l":"細かい仕事を任せる","fx":{"body":2,"sat":-1},"after":"細かい仕事は若い者に任せ、目を休めるようにした。"},{"k":"korasu","l":"目をこらして続ける","fx":{"sat":1,"body":-2},"after":"かすむ目をこらして、細かい仕事を続けた。"}]},
 {"id":"s6.fb.karada.4","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["階段や坂道で息が切れるようになった。歩く道を変えるか、毎日歩いて足を鍛えるか。"],"options":[{"k":"taira","l":"平らな道を選ぶ","fx":{"body":1,"sat":-1},"after":"遠回りでも平らな道を選び、息を切らさずに歩いた。"},{"k":"kitaeru","l":"毎日歩いて足を鍛える","fx":{"body":2,"sat":-2},"after":"息が切れても、毎日坂道を歩いて足を鍛えた。"}]},
 {"id":"s6.fb.karada.5","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["寝つけない夜が増えた。早く床に入って体を休めるか、夜の静かな時間を好きなことに使うか。"],"options":[{"k":"neru","l":"早く床に入る","fx":{"body":2,"sat":-1},"after":"早めに床に入り、眠れなくても体を横にして休めた。"},{"k":"yoru","l":"夜の時間を楽しむ","fx":{"sat":2,"body":-1},"after":"眠れない夜は、灯りの下で好きなことをして過ごした。"}]},
 {"id":"s6.fb.tanoshimi.1","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["若いころにやめた手なぐさみを、もう一度始めてみようかと思う。"],"options":[{"k":"hajimeru","l":"もう一度始める","fx":{"sat":2,"body":-1},"after":"若いころの手なぐさみを、もう一度始めた。"},{"k":"mama","l":"今のままでいい","fx":{"body":1,"sat":-1},"after":"昔の手なぐさみは思い出にとどめ、今の暮らしを続けた。"}]},
 {"id":"s6.fb.tanoshimi.2","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["近くで、歌や踊りの集まりが開かれていると聞いた。顔を出してみるか。"],"options":[{"k":"deru","l":"集まりに顔を出す","fx":{"sat":1,"tie":2,"body":-1},"after":"歌や踊りの集まりに顔を出し、顔なじみが増えた。"},{"k":"ie","l":"家でゆっくりする","fx":{"body":1,"tie":-1},"after":"集まりには行かず、家でゆっくり過ごした。"}]},
 {"id":"s6.fb.tanoshimi.3","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["ひとりで過ごす夕方の時間が増えた。何か打ちこめることを探すか。"],"options":[{"k":"sagasu","l":"打ちこめることを探す","fx":{"sat":2,"body":-1},"after":"夕方の時間に打ちこめることを探し、手を動かす楽しみを見つけた。"},{"k":"nonbiri","l":"のんびり過ごす","fx":{"body":1,"sat":-1},"after":"何もしない夕方を、のんびりと味わった。"}]},
 {"id":"s6.fb.tanoshimi.4","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["昔から好きだった草花を、庭や鉢で育ててみようかと思う。"],"options":[{"k":"sodateru","l":"草花を育てる","fx":{"sat":2,"learn":1,"body":-1},"after":"庭の隅に草花を植え、毎朝水をやるのが楽しみになった。"},{"k":"shigoto","l":"今の仕事に手を尽くす","fx":{"body":1,"sat":-1},"after":"草花を育てるのは見送り、今の仕事に手を尽くした。"}]},
 {"id":"s6.fb.tanoshimi.5","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["知り合いに、碁や将棋の相手を頼まれた。付き合うか、断るか。"],"options":[{"k":"aite","l":"盤の相手をする","fx":{"tie":2,"sat":1,"body":-1},"after":"碁や将棋の相手をするうちに、知り合いと気の置けない仲になった。"},{"k":"yoji","l":"自分の用を片づける","fx":{"body":1,"tie":-1},"after":"盤の相手は断り、自分の用を片づけた。"}]},
 {"id":"s6.fb.shinjin.1","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["近くの寺の法話に誘われた。聞きに行くか。"],"options":[{"k":"kiku","l":"法話を聞きに行く","fx":{"sat":2,"tie":1,"body":-1},"after":"寺の法話を聞き、少し心が落ち着いた。"},{"k":"yasumu","l":"家で体を休める","fx":{"body":1,"tie":-1},"after":"法話には行かず、家で体を休めた。"}]},
 {"id":"s6.fb.shinjin.2","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["亡くなった人たちのことを思い出す日が増えた。墓参りに通うか。"],"options":[{"k":"haka","l":"墓参りに通う","fx":{"sat":2,"tie":1,"body":-1},"after":"折にふれて墓に参り、亡くなった人たちに語りかけた。"},{"k":"awaseru","l":"家で手を合わせる","fx":{"body":1,"tie":-1},"after":"出かけずに、家で静かに手を合わせた。"}]},
 {"id":"s6.fb.shinjin.3","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["年の初めに、近くの社へお参りに行くかどうか迷っている。"],"options":[{"k":"mairu","l":"社へお参りに行く","fx":{"sat":2,"tie":1,"body":-1},"after":"年の初めに社へ参り、一年の無事を祈った。"},{"k":"mukaeru","l":"家で年を迎える","fx":{"body":1,"tie":-1},"after":"寒い中を出かけず、家で静かに年を迎えた。"}]},
 {"id":"s6.fb.shinjin.4","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["身近な人の法事が続き、自分の終わりのことを考えるようになった。"],"options":[{"k":"totonoeru","l":"身の回りを整えておく","fx":{"tie":2,"sat":-1},"after":"身の回りの物を少しずつ片づけ、家の者に言い残すことを伝えた。"},{"k":"ima","l":"今を大事に暮らす","fx":{"sat":2,"tie":-1},"after":"先のことは考えすぎず、今日の暮らしを大事にした。"}]},
 {"id":"s6.fb.shinjin.5","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["ご先祖の話を、若い者に伝えておこうかと思う。"],"options":[{"k":"tsutaeru","l":"若い者に話して聞かせる","fx":{"tie":2,"learn":1,"body":-1},"after":"ご先祖の話を若い者に話して聞かせ、家の昔が受け継がれた。"},{"k":"shimau","l":"胸にしまっておく","fx":{"sat":1,"tie":-1},"after":"ご先祖の話は胸にしまい、自分の代で終わらせた。"}]},
 {"id":"s6.fb.kane.1","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["蓄えが少しできた。いざという時のために残すか、暮らしを楽にするために使うか。"],"options":[{"k":"tsukau","l":"暮らしのために使う","fx":{"sat":2,"body":1},"after":"思いきって使い、暮らしが少し楽になった。","money":{"f":-0.05}},{"k":"nokosu","l":"いざに備えて残す","fx":{"sat":-1},"after":"使わずに蓄えておき、いざという時に備えた。","money":{"f":0.03}}]},
 {"id":"s6.fb.kane.2","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["古くなった道具を新しくするか、直して使い続けるか。"],"options":[{"k":"arata","l":"道具を新しくする","fx":{"sat":2},"after":"古い道具を新しくし、仕事がはかどるようになった。","money":{"f":-0.05}},{"k":"naosu","l":"直して使い続ける","fx":{"sat":-1,"learn":1},"after":"古い道具を手入れして、直しながら使い続けた。","money":{"f":0.02}}]},
 {"id":"s6.fb.kane.3","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["知り合いから、少し金を貸してほしいと頼まれた。"],"options":[{"k":"kasu","l":"頼みを聞いて貸す","fx":{"tie":2},"after":"頼みを聞いて金を貸し、知り合いにたいそう感謝された。","money":{"f":-0.04}},{"k":"kasanai","l":"貸すのは断る","fx":{"sat":1,"tie":-1},"after":"貸すのは断り、知り合いとは少しぎくしゃくした。"}]},
 {"id":"s6.fb.kane.4","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["家の傷んだところを直すか、もう少し我慢するか。"],"options":[{"k":"shuri","l":"傷んだところを直す","fx":{"sat":1,"body":1},"after":"傷んだところを直し、家の中が過ごしやすくなった。","money":{"f":-0.05}},{"k":"gaman","l":"もう少し我慢する","fx":{"sat":-1},"after":"直すのはもう少し先にして、蓄えを守った。","money":{"f":0.03}}]},
 {"id":"s6.fb.kane.5","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["いつか旅に出たいと思い、少しずつ蓄えを分けておくか迷っている。"],"options":[{"k":"tabi","l":"旅の蓄えを分けておく","fx":{"sat":2},"after":"旅のための蓄えを少しずつ分けておき、行き先を思い描いた。","money":{"f":-0.03}},{"k":"akirameru","l":"旅はあきらめる","fx":{"sat":-1},"after":"旅の夢はしまいこみ、蓄えは家のために残した。","money":{"f":0.02}}]},
 {"id":"s6.fb.wakai.1","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["近所の若い者が、仕事のことで相談に来た。じっくり聞くか、手短に済ませるか。"],"options":[{"k":"jikkuri","l":"じっくり話を聞く","fx":{"tie":2,"body":-1},"after":"若い者の相談にじっくり付き合い、頼られるようになった。"},{"k":"temijika","l":"手短に済ませる","fx":{"sat":1,"tie":-1},"after":"相談は手短に済ませ、自分の仕事に戻った。"}]},
 {"id":"s6.fb.wakai.2","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["若い者に、昔のやり方を教えてほしいと頼まれた。"],"options":[{"k":"oshieru","l":"手を取って教える","fx":{"tie":2,"learn":1,"body":-1},"after":"昔のやり方を手を取って教え、若い者の腕が上がった。"},{"k":"jibun","l":"自分で覚えさせる","fx":{"sat":1,"tie":-1},"after":"教えるのは控え、若い者が自分で覚えるのに任せた。"}]},
 {"id":"s6.fb.wakai.3","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["若い者のやり方に、口を出したくなった。言うか、黙って見守るか。"],"options":[{"k":"iu","l":"思うところを言う","fx":{"sat":1,"tie":-1},"after":"黙っていられず思うところを言い、若い者は少し不服そうだった。"},{"k":"mimamoru","l":"黙って見守る","fx":{"tie":2,"sat":-1},"after":"口を出さずに見守り、若い者は自分のやり方で仕事を覚えた。"}]},
 {"id":"s6.fb.wakai.4","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["知り合いの子の行く末を、親から相談された。"],"options":[{"k":"noru","l":"親身に相談に乗る","fx":{"tie":2,"body":-1},"after":"知り合いの子の行く末を親と一緒に考え、心当たりを訪ねて回った。"},{"k":"hikaeru","l":"深入りを控える","fx":{"sat":1,"tie":-1},"after":"よその家のことだからと、深入りは控えた。"}]},
 {"id":"s6.fb.wakai.5","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["若い者が集まる場に、年長として呼ばれた。顔を出すか。"],"options":[{"k":"kao","l":"年長として顔を出す","fx":{"tie":2,"body":-1},"after":"若い者の集まりに顔を出し、昔の話をして喜ばれた。"},{"k":"makaseru","l":"若い者に任せる","fx":{"sat":1,"tie":-1},"after":"集まりは若い者に任せ、家でゆっくり過ごした。"}]},
 {"id":"s6.fb.tomo.1","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["長く会っていない昔なじみに、会いに行こうか迷っている。"],"options":[{"k":"au","l":"昔なじみに会いに行く","fx":{"tie":3,"body":-1},"after":"久しぶりに昔なじみの顔を見に行き、昔の話に花が咲いた。"},{"k":"miokuru","l":"今は見送る","fx":{"body":1,"tie":-1},"after":"会いに行くのは見送り、心の中で相手の無事を願った。"}]},
 {"id":"s6.fb.tomo.2","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["古い知り合いが病に伏せていると聞いた。見舞いに行くか。"],"options":[{"k":"mimai","l":"見舞いに行く","fx":{"tie":3,"body":-1},"after":"病に伏せる知り合いを見舞い、手を握って励ました。"},{"k":"hitozute","l":"人づてに見舞う","fx":{"body":1,"tie":-1},"after":"自分では行かず、人づてに見舞いの品を届けた。"}]},
 {"id":"s6.fb.tomo.3","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["昔の仲間から、久しぶりに集まらないかと便りが来た。"],"options":[{"k":"dekakeru","l":"集まりに出かける","fx":{"tie":3,"body":-1},"after":"昔の仲間と久しぶりに集まり、夜遅くまで語り合った。"},{"k":"kotowaru","l":"今回は断る","fx":{"body":1,"tie":-1},"after":"集まりは断り、仲間の顔を思い浮かべるだけにした。"}]},
 {"id":"s6.fb.tomo.4","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["けんか別れしたままの知り合いのことが、ふと気になった。"],"options":[{"k":"tazuneru","l":"自分から訪ねる","fx":{"tie":3,"sat":-1},"after":"思いきって自分から訪ね、長いわだかまりがほどけた。"},{"k":"sotto","l":"そっとしておく","fx":{"sat":1,"tie":-1},"after":"昔のことはそっとしておき、蒸し返さなかった。"}]},
 {"id":"s6.fb.tomo.5","kind":"small","y":[1000,2100],"a":[40,110],"when":{"kind":["village","fish","town","city"],"ind":["home"]},"text":["昔世話になった人に、礼を言いに行こうかと思う。"],"options":[{"k":"rei","l":"礼を言いに行く","fx":{"tie":3,"body":-1},"after":"昔世話になった人を訪ね、改めて礼を伝えた。"},{"k":"kokoro","l":"心の中で感謝する","fx":{"body":1,"tie":-1},"after":"訪ねるのは見送り、心の中で手を合わせて感謝した。"}]}
]
