{"id":"s6.l.j19a.081","y":[1350,1573],"a":[18,65],"when":{"jobIs":["山鉾の大工"]},"t":["{name}は縄だけで木を締め上げ、釘を使わずに鉾を組み立てた。"],"cat":"地域"},
{"id":"s6.l.j19a.082","y":[1333,1573],"a":[18,60],"when":{"jobIs":["青苧の商人"]},"t":["{name}は越後の村々を回って青苧を買い集め、束ねて馬の背に積んだ。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.083","y":[1380,1573],"a":[14,40],"when":{"jobIs":["同朋衆の弟子"]},"t":["{name}は会所の床に唐物の香炉を据え、掛物の位置を指一本ずつ直した。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.084","y":[1350,1573],"a":[12,65],"when":{"jobIs":["能の囃子方"]},"t":["{name}は鏡の間で小鼓の調べ緒を締め、息を吸って最初の掛け声を出した。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.085","y":[1333,1573],"a":[20,65],"when":{"jobIs":["香木の商人"]},"t":["{name}は香木を小刀で薄く削り、炭の上で焚いて香りの質を確かめた。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.086","y":[1350,1573],"a":[18,65],"when":{"jobIs":["茶臼作り"]},"t":["{name}は石の臼の面に、車の輻のように走る溝を鑿で刻んでいった。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.087","y":[1380,1573],"a":[25,70],"when":{"jobIs":["天目茶碗の目利き"]},"t":["{name}は灯にかざした天目茶碗の釉の斑を、目を細めて見つめた。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.088","y":[1401,1547],"a":[16,50],"when":{"jobIs":["遣明船の水夫"]},"t":["{name}は遣明船の帆柱に登り、五島の島影が遠ざかるのを見た。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.089","y":[1404,1547],"a":[20,65],"when":{"jobIs":["勘合の写し役"]},"t":["{name}は勘合の料紙に、割印の位置を確かめながら字を写した。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.090","y":[1480,1573],"a":[20,65],"when":{"jobIs":["数寄屋大工"]},"t":["{name}は細い杉の丸太を選び、茶の座敷の天井の高さを測った。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.091","y":[1467,1600],"a":[15,50],"when":{"jobIs":["乱波"]},"t":["{name}は行商人のなりで敵の城下に入り、門の番の数を数えた。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.092","y":[1467,1600],"a":[20,70],"when":{"jobIs":["陣僧"]},"t":["陣僧の{name}は、討ち死にした兵の名を一人ずつ過去帳に書き付けた。"],"cat":"時代"},
{"id":"s6.l.j19a.093","y":[1530,1600],"a":[35,75],"when":{"jobIs":["御伽衆"]},"t":["御伽衆の{name}は、夜の御殿で、諸国の城の噂話を主に聞かせた。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.094","y":[1550,1600],"a":[25,75],"when":{"jobIs":["茶頭"]},"t":["茶頭の{name}は、唐物の茶入を仕覆から出し、炉の炭を直した。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.095","y":[1549,1600],"a":[18,60],"when":{"jobIs":["南蛮通詞"]},"t":["{name}はポルトガルの言葉を覚えるため、商人の数の言い方を紙に書き付けた。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.096","y":[1549,1600],"a":[15,50],"when":{"jobIs":["同宿"]},"t":["同宿の{name}は、宣教師の説教を聞いた人々に、日本の言葉で教えを言い直して伝えた。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.097","y":[1467,1600],"a":[18,60],"when":{"jobIs":["陣借りの商人"]},"t":["{name}は陣の外れに筵を敷き、兵に草鞋と干し飯を売った。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.098","y":[1467,1600],"a":[15,55],"when":{"jobIs":["小荷駄"]},"t":["小荷駄の{name}は、馬の背の米俵の縄を締め直し、隊列の後ろを歩いた。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.099","y":[1467,1600],"a":[16,55],"when":{"jobIs":["舟手衆"]},"t":["舟手衆の{name}は、潮の流れを確かめて、関船の櫓を漕ぎ出した。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.100","y":[1500,1600],"a":[18,65],"when":{"jobIs":["鑓師"]},"t":["{name}は焼き入れをした槍の穂を、砥石で三方の刃に研ぎ上げた。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.101","y":[1574,1600],"a":[15,65],"when":{"jobIs":["楽焼の陶工"]},"t":["{name}は小さな内窯から赤く焼けた碗を鋏で取り出し、水に浸して冷ました。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.102","y":[1467,1600],"a":[16,55],"when":{"jobIs":["甲賀衆"]},"t":["{name}は甲賀の山あいの城の土塁に立ち、谷の道を行き来する者を見張った。"],"cat":"地域"},
{"id":"s6.l.j19a.103","y":[1467,1600],"a":[16,45],"when":{"jobIs":["早馬の使い"]},"t":["{name}は書状を油紙に包んで懐に入れ、夜明け前の街道へ馬を出した。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.104","y":[1467,1600],"a":[14,50],"when":{"jobIs":["陣太鼓打ち"]},"t":["{name}は大太鼓の前に立ち、撥を握って進めの合図を待った。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.105","y":[1467,1600],"a":[30,75],"when":{"jobIs":["軍配者"]},"t":["{name}は足利の学校で学んだ易の書を開き、出陣の日の干支を数えた。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.106","y":[1467,1600],"a":[15,55],"when":{"jobIs":["城の普請人足"]},"t":["{name}はもっこで土を担ぎ、城の堀から土塁の上へと運んだ。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.107","y":[1467,1600],"a":[30,75],"when":{"jobIs":["連歌の宗匠"]},"t":["宗匠の{name}は、懐紙に記した百韻の句を、座の皆に声に出して披露した。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.108","y":[1467,1600],"a":[20,70],"when":{"jobIs":["猿楽の太夫"]},"t":["猿楽の太夫の{name}は、面をかける前に鏡の間で静かに座った。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.109","y":[1467,1600],"a":[25,70],"when":{"jobIs":["宿の亭主"]},"t":["{name}は宿の土間で旅人の足を洗う湯を沸かし、飛脚の荷を預かった。"],"cat":"地域"},
{"id":"s6.l.j19a.110","y":[1467,1600],"a":[30,70],"when":{"jobIs":["城の番匠頭"]},"t":["番匠頭の{name}は、板図を広げ、大工たちに柱の位置を指で示した。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.111","y":[1550,1600],"a":[16,55],"when":{"jobIs":["黒鍬"]},"t":["黒鍬の{name}は、鍬をふるって陣の前の土を掘り、土塁を盛った。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.112","y":[1550,1600],"a":[18,45],"when":{"jobIs":["母衣武者"]},"t":["{name}は背の母衣を風にふくらませ、陣から陣へ馬を走らせた。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.113","y":[1467,1600],"a":[30,70],"when":{"jobIs":["弓の師範"]},"t":["{name}は的場で若侍の肘を押さえ、弓を引き分ける形を正した。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.114","y":[1555,1600],"a":[15,65],"when":{"jobIs":["硝石作り"]},"t":["{name}は囲炉裏の下の土に蚕の糞と草を混ぜ、塩硝ができるのを待った。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.115","y":[1543,1600],"a":[18,65],"when":{"jobIs":["火薬師"]},"t":["{name}は火の気のない小屋で、硝石と硫黄と炭を薬研で挽いて混ぜ合わせた。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.116","y":[1543,1600],"a":[20,65],"when":{"jobIs":["鉛の商人"]},"t":["{name}は南蛮船の積荷の鉛を天秤ではかり、棒にして蔵へ運ばせた。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.117","y":[1560,1600],"a":[25,70],"when":{"jobIs":["キリシタンの看坊"]},"t":["看坊の{name}は、宣教師の来ない日曜、村の信者を集めて祈りの言葉を唱えた。"],"cat":"地域"},
{"id":"s6.l.j19a.118","y":[1580,1600],"a":[11,20],"when":{"jobIs":["セミナリヨの学生"]},"t":["{name}はセミナリヨの部屋で、ラテン語の祈りを仲間と声をそろえて唱えた。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.119","y":[1560,1587],"a":[18,65],"when":{"jobIs":["南蛮寺の大工"]},"t":["{name}は南蛮寺の梁を組みながら、宣教師の鳴らす鐘の音を初めて聞いた。"],"cat":"学歴と仕事"},
{"id":"s6.l.j19a.120","y":[1550,1600],"a":[15,55],"when":{"jobIs":["南蛮船の荷揚げ人足"]},"t":["{name}は平戸の浜で、南蛮船から下ろした小舟の荷を肩に担いだ。"],"cat":"地域"}
]
